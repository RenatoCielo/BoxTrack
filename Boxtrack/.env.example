# Global environment example for BOXTRACK
# Copy this file to .env and replace values with your local configuration.

# Django / backend
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL
DB_NAME=boxtrack_db
DB_USER=boxtrack_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME=BOXTRACK

# Online store checkout (Mercado Pago Chile)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=https://your-public-domain.example/api/store/payments/mercadopago/webhook/
FRONTEND_URL=http://localhost:5173

# Email / optional future integrations
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=example@domain.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
